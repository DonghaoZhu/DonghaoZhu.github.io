3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"About — Donghao Zhu"}],["$","meta","1",{"name":"description","content":"Donghao Zhu is a Tenure-Track Assistant Professor at the University of Tsukuba, researching operations management, optimization, and AI in business."}],["$","link","2",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","3",{"rel":"canonical","href":"https://donghaozhu.github.io"}],["$","link","4",{"rel":"alternate","hrefLang":"en","href":"https://donghaozhu.github.io"}],["$","link","5",{"rel":"alternate","hrefLang":"ja","href":"https://donghaozhu.github.io/ja/"}],["$","link","6",{"rel":"alternate","hrefLang":"x-default","href":"https://donghaozhu.github.io"}],["$","meta","7",{"name":"google-site-verification","content":"q8DtGMRIbR6QaJVsuBq_ia7dVYog6Z1o9Lwm4-AZP-w"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L6",null,{"fallback":"$7","children":["$","$L8",null,{"fallback":"$7","children":["$","$L9",null,{"providerId":"layout:/","segmentMap":{"children":[]},"children":["$","$La",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$Lb",null,{"resetKey":"","fallback":["$","$Lc",null,{}],"children":["$","$Lb",null,{"resetKey":"","fallback":["$","$Lc",null,{}],"children":["$","$Ld",null,{"children":["$","$Le",null,{"children":[["$","$L9",null,{"providerId":"page:/","segmentMap":{"children":["__PAGE__"]},"children":["$","$La",null,{"id":"page:/"}]}],null]}]}]}]}]}]}]}]}],null,null]

1:["$","main",null,{"id":"main","className":"page-width home-page","children":[["$","section",null,{"className":"about-section","aria-labelledby":"about-title","children":[["$","img",null,{"className":"profile-photo","src":"/donghao-zhu-retouched.png","alt":"Donghao Zhu","width":"1070","height":"1470"}],["$","div",null,{"className":"about-copy","children":[["$","h1",null,{"id":"about-title","children":["$","span",null,{"className":"person-name","lang":"en","children":"Donghao Zhu"}]}],["$","div",null,{"className":"biography","children":[["$","p",null,{"children":["I am a ",["$","strong",null,{"children":"Tenure-Track Assistant Professor"}]," in the"," ",["$","a",null,{"href":"https://www.mbaib.gsbs.tsukuba.ac.jp/facultyindex/donghao-zhu/","target":"_blank","rel":"noreferrer","children":"Institute of Business Science, University of Tsukuba"}],", Tokyo Campus, and a Visiting Scholar at the"," ",["$","a",null,{"href":"https://www.mdc.e.u-tokyo.ac.jp/en/people/","target":"_blank","rel":"noreferrer","children":"University of Tokyo Market Design Center"}],"."]}],["$","p",null,{"children":["My research focuses on ",["$","strong",null,{"children":"Operations Management"}],", particularly the modeling, analysis, and optimization of business operations and decision-making. My work involves developing and evaluating optimization methods, analyzing business models, and exploring how artificial intelligence can enhance and transform traditional business operations. Beyond operational efficiency, I am also interested in fairness in business decision-making and resource allocation."]}],["$","p",null,{"children":["I am also actively engaged in promoting"," ",["$","strong",null,{"children":"industry–academia collaboration"}],", with a particular emphasis on translating AI-driven business models into practical applications and incubating new ventures. In 2026, I was selected as a"," ",["$","a",null,{"href":"https://tristar.sec.tsukuba.ac.jp/tristar/","target":"_blank","rel":"noreferrer","children":"TRiSTAR Pre-Fellow"}]," ","to further advance my research and innovation activities."]}],["$","p",null,{"children":"I received my Ph.D. from the Technical University of Munich and my M.Sc. from the University of Tokyo. Before joining Tsukuba, I worked at the Institute of Statistical Mathematics."}]]}],["$","div",null,{"className":"profile-links","aria-label":"Profile links","children":[["$","a",null,{"href":"https://www.mbaib.gsbs.tsukuba.ac.jp/facultyindex/donghao-zhu/","target":"_blank","rel":"noreferrer","children":"Tsukuba Profile"}],["$","a",null,{"href":"https://trios.tsukuba.ac.jp/en/researcher/0000005287","target":"_blank","rel":"noreferrer","children":"Trios Profile"}],["$","a",null,{"href":"https://www.mdc.e.u-tokyo.ac.jp/en/people/","target":"_blank","rel":"noreferrer","children":"UTMD Profile"}],["$","a",null,{"href":"https://scholar.google.com/citations?user=_HGnO3AAAAAJ&hl=en","target":"_blank","rel":"noreferrer","children":"Google Scholar"}],["$","a",null,{"href":"mailto:zhu.donghao.gt@u.tsukuba.ac.jp","children":"Email"}]]}]]}]]}],["$","section",null,{"className":"home-opportunities","id":"opportunities","aria-labelledby":"opportunities-title","children":[["$","h2",null,{"id":"opportunities-title","children":"Prospective Students & Researchers"}],["$","div",null,{"className":"opportunities-copy","children":[["$","p",null,{"children":["I welcome students and researchers interested in the mathematical modeling and analysis of business problems, the theory and applications of AI in business, and industry–academia collaboration. Please feel free to"," ",["$","a",null,{"href":"mailto:zhu.donghao.gt@u.tsukuba.ac.jp","children":"email me"}]," to discuss research opportunities and potential collaboration."]}],["$","h3",null,{"children":"Graduate students"}],["$","p",null,{"children":["Prospective master's students should apply through the"," ",["$","a",null,{"href":"https://www.mbaib.gsbs.tsukuba.ac.jp/admissionindex/admission-information/","target":"_blank","rel":"noreferrer","children":"MBA-IB program's admissions process"}],". Our graduate school is designed for working professionals, and applicants with work experience in Japan are especially welcome. Students interested in doctoral study generally complete the master's program first and then apply for doctoral admission. I am currently unable to accept non-degree research students (kenkyusei)."]}],"$Lf","$L10","$L11","$L12"]}]]}],"$L13"]}]

10:["$","p",null,{"children":"I welcome postdoctoral researchers, but I currently have insufficient funding to support postdoctoral positions directly. Applicants therefore need to secure external funding."}]
11:["$","p",null,{"children":["Depending on eligibility and current calls, possible funding sources include"," ",["$","a",null,{"href":"https://www.jsps.go.jp/english/e-pd/","target":"_blank","rel":"noreferrer","children":"JSPS PD and RPD fellowships"}]," ","and"," ",["$","a",null,{"href":"https://www.jsps.go.jp/english/e-fellow/","target":"_blank","rel":"noreferrer","children":"JSPS international fellowships: Standard, Short-term (PE), and Short-term (PA)"}],". Other external funding sources, including support from private companies, are also welcome."]}]
12:["$","p",null,{"children":"I also welcome postdoctoral researchers from China supported by the China Scholarship Council (CSC)."}]
